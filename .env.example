# Runtime profile
RAG_ENV=development

# LLM gateway
OPENAI_API_KEY=
RAG_LLM_MODEL=gpt-5.5
RAG_LLM_BASE_URL=https://oneapi-comate.baidu-int.com/v1

# Embeddings and reranker
RAG_EMBEDDING_MODEL=bge-large-zh
RAG_EMBEDDING_BASE_URL=https://qianfan.baidubce.com/v2
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIMENSION=512
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_MODEL_DEVICE=cpu
HF_HUB_OFFLINE=true

# Retrieval
MILVUS_URI=http://127.0.0.1:19530
RAG_COLLECTION_NAME=t_collection01
RAG_RETRIEVAL_TOP_K=16
RAG_RERANK_TOP_N=4
RAG_RETRIEVAL_SCORE_THRESHOLD=0.0
RAG_RRF_K=100
RAG_FUSION_MODE=rrf
RAG_DENSE_WEIGHT=0.5
RAG_SPARSE_WEIGHT=0.5
RAG_RERANK_TIMEOUT_SECONDS=2.0
RAG_CONTEXT_MAX_TOKENS=2048

# Bounded workflow and durable conversations
RAG_MAX_STEPS=16
RAG_MAX_RETRIEVAL_ATTEMPTS=3
RAG_MAX_GENERATION_ATTEMPTS=3
RAG_MAX_QUERY_TRANSFORMS=2
RAG_MAX_WEB_SEARCHES=1
RAG_MAX_TOTAL_TOKENS=8192
RAG_REQUEST_TIMEOUT_SECONDS=30
# Local development uses SQLite. Production must use postgres with PostgreSQL and Redis URLs.
RAG_STATE_BACKEND=sqlite
RAG_CHECKPOINT_PATH=.rag-state/checkpoints.sqlite3
RAG_DATABASE_URL=
RAG_DB_POOL_MIN_SIZE=1
RAG_DB_POOL_MAX_SIZE=16
RAG_DB_POOL_TIMEOUT_SECONDS=5
RAG_REDIS_URL=
RAG_REDIS_SOCKET_TIMEOUT_SECONDS=1
RAG_CONVERSATION_LOCK_TTL_SECONDS=45
RAG_CONVERSATION_LOCK_ACQUIRE_TIMEOUT_SECONDS=0.25
RAG_CONVERSATION_TTL_SECONDS=86400
RAG_CONVERSATION_SUMMARY_MAX_CHARS=2000

# Durable request recovery (PostgreSQL mode only)
RAG_GRAPH_VERSION=graph2-bounded-v1
RAG_INPUT_SCHEMA_VERSION=1
RAG_RECOVERY_ENABLED=false
RAG_RECOVERY_MAX_ATTEMPTS=3
RAG_RECOVERY_WINDOW_SECONDS=300
RAG_RUN_LEASE_SECONDS=45
RAG_RUN_HEARTBEAT_SECONDS=10
RAG_RECOVERY_POLL_SECONDS=1
RAG_RECOVERY_CONCURRENCY=2
# Production must use an HTTPS IAM endpoint and a service credential.
RAG_RECOVERY_AUTHORIZATION_URL=
RAG_RECOVERY_AUTHORIZATION_TOKEN=

# HTTP service (one worker per process; scale production with pods)
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
# Production gateway secret: generate at least 32 random characters.
RAG_GATEWAY_SHARED_SECRET=

# Production container: absolute host path containing the preloaded Hugging Face cache.
RAG_MODEL_CACHE_PATH=

# Reliability controls (protective defaults, not measured SLOs)
RAG_MAX_CONCURRENT_REQUESTS=12
RAG_CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=0.25
RAG_TENANT_REQUEST_BURST=20
RAG_TENANT_REQUESTS_PER_MINUTE=60
RAG_DEPENDENCY_MAX_ATTEMPTS=2
RAG_DEPENDENCY_RETRY_INITIAL_SECONDS=0.05
RAG_DEPENDENCY_RETRY_MAX_SECONDS=0.5
RAG_CIRCUIT_FAILURE_THRESHOLD=3
RAG_CIRCUIT_RECOVERY_SECONDS=30
RAG_LLM_TIMEOUT_SECONDS=20

# Optional external search
TAVILY_API_KEY=

# Optional tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
